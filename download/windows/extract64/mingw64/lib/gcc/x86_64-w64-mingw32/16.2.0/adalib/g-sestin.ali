V "GNAT Lib v16"
A -nostdinc
A -O2
A -Wextra
A -Wall
A -gnatwa
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=nocona
P ZX

RN
RV NO_LONG_LONG_INTEGERS

U gnat.secondary_stack_info%s  g-sestin.ads	757f640c NE OL PK
W gnat%s		gnat.ads		gnat.ali
W system%s		system.ads		system.ali
W system.secondary_stack%s  s-secsta.adb	s-secsta.ali

D ada.ads		20260807074606 76789da1 ada%s
D a-unccon.ads		20260807074606 0e9b276f ada.unchecked_conversion%s
D gnat.ads		20260807074606 b5988c27 gnat%s
D g-sestin.ads		20260807074606 976591de gnat.secondary_stack_info%s
D system.ads		20260807074606 898beeee system%s
D s-exctab.ads		20260807074606 91bef6ef system.exception_table%s
D s-parame.ads		20260807074606 a1aeab5c system.parameters%s
D s-secsta.ads		20260807074606 578279f5 system.secondary_stack%s
D s-stalib.ads		20260807074606 1c9580f6 system.standard_library%s
D s-stoele.ads		20260807074606 ccded4e8 system.storage_elements%s
G a e
X 3 gnat.ads
40K9*GNAT 63e9 4|38r9 45r5
X 4 g-sestin.ads
38K14*Secondary_Stack_Info 3|40k9 4|45l10 45e30
40V13*SS_Get_Max=41:37{long_long_integer}
X 5 system.ads
37K9*System 4|36r6 41r14 5|214e11
X 8 s-secsta.ads
35K16*Secondary_Stack 4|36w13 41r21 8|429e27
98V13*SS_Get_Max{long_long_integer} 4|41r37

