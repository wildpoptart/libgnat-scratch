V "GNAT Lib v16"
A -nostdinc
A -O2
A -Wextra
A -Wall
A -gnatwa
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=nocona
P ZX

RN

U gnat.htable%b		g-htable.adb		9f9cc922 NE OL PK
W gnat%s		gnat.ads		gnat.ali

U gnat.htable%s		g-htable.ads		4a45b320 EB NE OL PR PK
W gnat%s		gnat.ads		gnat.ali
W system%s		system.ads		system.ali
W system.htable%s	s-htable.adb		s-htable.ali

D ada.ads		20260807074606 76789da1 ada%s
D a-unccon.ads		20260807074606 0e9b276f ada.unchecked_conversion%s
D gnat.ads		20260807074606 b5988c27 gnat%s
D g-htable.ads		20260807074606 7e0467ec gnat.htable%s
D g-htable.adb		20260807074606 e198aece gnat.htable%b
D system.ads		20260807074606 898beeee system%s
D s-exctab.ads		20260807074606 91bef6ef system.exception_table%s
D s-htable.ads		20260807074606 81d958eb system.htable%s
D s-stalib.ads		20260807074606 1c9580f6 system.standard_library%s
G a e
X 3 gnat.ads
