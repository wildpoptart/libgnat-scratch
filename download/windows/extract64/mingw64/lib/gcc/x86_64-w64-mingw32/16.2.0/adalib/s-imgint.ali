V "GNAT Lib v16"
A -nostdinc
A -O2
A -Wextra
A -Wall
A -gnatwa
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=nocona
P ZX

RN
RV NO_DIRECT_BOOLEAN_OPERATORS
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_ASPECT_SPECIFICATIONS
RV NO_IMPLEMENTATION_PRAGMAS

U system.img_int%s	s-imgint.ads		1eabfddc NE OL PK
W system%s		system.ads		system.ali
W system.image_i%s

D system.ads		20260807074606 898beeee system%s
D s-imagei.ads		20260807074606 11a376a2 system.image_i%s
D s-imagei.adb		20260807074606 e81b26f1 system.image_i%b
D s-imgint.ads		20260807074606 86836590 system.img_int%s
G a e
G c Z s s [image_integer system__img_int__impl 40 14 41_4]
G c Z s s [set_image_integer system__img_int__impl 48 14 41_4]
G c Z s s [set_digits system__img_int__impl 36 14 41_4]
X 1 system.ads
37K9*System 214e11 4|36r6 38r9 76r5
X 2 s-imagei.ads
38k16*Image_I 58e19 4|36w13 41r24
40U14*Image_Integer 4|47r19[41]
48U14*Set_Image_Integer 4|60r19[41]
X 4 s-imgint.ads
38K16*Img_Int 1|37k9 4|76l12 76e19
41K12*Impl[2|38] 47r14 60r14
43U14*Image_Integer=47:19
44i7 V{integer}
45a7 S{string}
46i7 P{natural}
56U14*Set_Image_Integer=60:19
57i7 V{integer}
58a7 S{string}
59i7 P{natural}

