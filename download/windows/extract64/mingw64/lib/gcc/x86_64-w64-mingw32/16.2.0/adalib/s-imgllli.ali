V "GNAT Lib v16"
A -nostdinc
A -O2
A -Wextra
A -Wall
A -gnatwa
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=nocona
P ZX

RN
RV NO_DIRECT_BOOLEAN_OPERATORS
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_ASPECT_SPECIFICATIONS
RV NO_IMPLEMENTATION_PRAGMAS

U system.img_llli%s	s-imgllli.ads		3dd947cf NE OL PK
W system%s		system.ads		system.ali
W system.image_i%s

D system.ads		20260807074606 898beeee system%s
D s-imagei.ads		20260807074606 11a376a2 system.image_i%s
D s-imagei.adb		20260807074606 e81b26f1 system.image_i%b
D s-imgllli.ads		20260807074606 a5f1df83 system.img_llli%s
G a e
G c Z s s [image_integer system__img_llli__impl 40 14 41_4]
G c Z s s [set_image_integer system__img_llli__impl 48 14 41_4]
G c Z s s [set_digits system__img_llli__impl 36 14 41_4]
X 1 system.ads
37K9*System 214e11 4|36r6 38r9 55r5
X 2 s-imagei.ads
38k16*Image_I 58e19 4|36w13 41r24
40U14*Image_Integer 4|47r19[41]
48U14*Set_Image_Integer 4|53r19[41]
X 4 s-imgllli.ads
38K16*Img_LLLI 1|37k9 4|55l12 55e20
41K12*Impl[2|38] 47r14 53r14
43U14*Image_Long_Long_Long_Integer=47:19
44i7 V{long_long_long_integer}
45a7 S{string}
46i7 P{natural}
49U14*Set_Image_Long_Long_Long_Integer=53:19
50i7 V{long_long_long_integer}
51a7 S{string}
52i7 P{natural}

