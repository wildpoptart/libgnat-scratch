V "GNAT Lib v16"
A -nostdinc
A -O2
A -Wextra
A -Wall
A -gnatwa
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=nocona
P ZX

RN
RV NO_LONG_LONG_INTEGERS
RV NO_IMPLEMENTATION_ASPECT_SPECIFICATIONS

U system.exp_lli%s	s-explli.ads		c09ff0b3 NE OL PK
W system%s		system.ads		system.ali
W system.expont%s

D system.ads		20260807074606 898beeee system%s
D s-explli.ads		20260807074606 ac480e57 system.exp_lli%s
D s-expont.ads		20260807074606 e55c100a system.expont%s
D s-expont.adb		20260807074606 e11cd2b5 system.expont%b
G a e
G c Z s s [expon system__exp_lli__expont_integer 41 13 39_4]
X 1 system.ads
37K9*System 214e11 2|34r6 36r9 53r5
X 2 s-explli.ads
36K16*Exp_LLI 1|37k9 2|53l12 53e19
39K12*Expont_Integer[3|38] 43r14
41V13*Exp_Long_Long_Integer=43:29{long_long_integer}
42i7 Left{long_long_integer}
42i33 Right{natural}
X 3 s-expont.ads
38k16*Expont 2|34w13 39r34 3|50e18
41V13*Expon{long_long_integer} 2|43r29[39]

