V "GNAT Lib v16"
A -nostdinc
A -O2
A -Wextra
A -Wall
A -gnatwa
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=nocona
P ZX

RN
RV NO_LONG_LONG_INTEGERS
RV NO_IMPLEMENTATION_ASPECT_SPECIFICATIONS

U system.exn_lli%s	s-exnlli.ads		043a32ba NE OL PK
W system%s		system.ads		system.ali
W system.exponn%s

D system.ads		20260807074606 898beeee system%s
D s-exnlli.ads		20260807074606 cdbd4493 system.exn_lli%s
D s-exponn.ads		20260807074606 400c98c7 system.exponn%s
D s-exponn.adb		20260807074606 12850e72 system.exponn%b
G a e
G c Z s s [expon system__exn_lli__exponn_integer 41 13 40_4]
X 1 system.ads
37K9*System 214e11 2|34r6 36r9 55r5
X 2 s-exnlli.ads
36K16*Exn_LLI 1|37k9 2|55l12 55e19
40K12*Exponn_Integer[3|38] 44r14
42V13*Exn_Long_Long_Integer=44:29{long_long_integer}
43i7 Left{long_long_integer}
43i33 Right{natural}
X 3 s-exponn.ads
38k16*Exponn 2|34w13 40r34 3|50e18
41V13*Expon{long_long_integer} 2|44r29[40]

