V "GNAT Lib v16"
A -nostdinc
A -O2
A -Wextra
A -Wall
A -gnatwa
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=nocona
P ZX

RN
RV NO_DYNAMIC_SIZED_OBJECTS

U gnat.spelling_checker%b  g-speche.adb		5c6b6cce NE OL PK
W gnat%s		gnat.ads		gnat.ali
W gnat.spelling_checker_generic%s  g-spchge.adb	g-spchge.ali

U gnat.spelling_checker%s  g-speche.ads		f187db88 NE OL PU PK
W gnat%s		gnat.ads		gnat.ali

D ada.ads		20260807074606 76789da1 ada%s
D a-unccon.ads		20260807074606 0e9b276f ada.unchecked_conversion%s
D gnat.ads		20260807074606 b5988c27 gnat%s
D g-speche.ads		20260807074606 441f57af gnat.spelling_checker%s
D g-speche.adb		20260807074606 116bb3ac gnat.spelling_checker%b
D g-spchge.ads		20260807074606 091f88cd gnat.spelling_checker_generic%s
D g-spchge.adb		20260807074606 fb9c05db gnat.spelling_checker_generic%b
D system.ads		20260807074606 898beeee system%s
D s-exctab.ads		20260807074606 91bef6ef system.exception_table%s
D s-stalib.ads		20260807074606 1c9580f6 system.standard_library%s
G a e
G c Z s b [is_bad_spelling_of gnat__spelling_checker 43 13 none]
G c Z b b [ibsR gnat__spelling_checker__ibsGP2459 36 13 none]
G c Z b b [ibs gnat__spelling_checker 36 13 none]
X 3 gnat.ads
40K9*GNAT 63e9 4|40r9 56r5 5|32r6 34r14 37r6 49r5
X 4 g-speche.ads
40K14*Spelling_Checker 3|40k9 4|56l10 56e26 5|34b19 49l10 49t26
