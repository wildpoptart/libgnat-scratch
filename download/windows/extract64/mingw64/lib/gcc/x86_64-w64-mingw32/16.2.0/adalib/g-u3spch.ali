G a e
G c Z s b [is_bad_spelling_of gnat__utf_32_spelling_checker 45 13 none]
G c Z b b [ibsR gnat__utf_32_spelling_checker__ibsGP2466 36 13 none]
G c Z b b [ibs gnat__utf_32_spelling_checker 36 13 none]
