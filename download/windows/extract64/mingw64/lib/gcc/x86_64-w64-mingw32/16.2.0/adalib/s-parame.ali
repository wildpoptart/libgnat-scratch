V "GNAT Lib v16"
A -nostdinc
A -O2
A -Wextra
A -Wall
A -gnatwa
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=nocona
P ZX

RN
RV NO_LONG_LONG_INTEGERS
RV NO_IMPLEMENTATION_ATTRIBUTES

U system.parameters%b	s-parame.adb		3007a9ef NE OL PK
W system%s		system.ads		system.ali

U system.parameters%s	s-parame.ads		282545b2 NE OL PU PK
W system%s		system.ads		system.ali

