V "GNAT Lib v4.6"
A -gnatwa
A -O2
A -O2
A -Wextra
A -Wall
A -fexceptions
A -fPIC
A -g
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=x86-64
P ZX
R nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn

U gnat.regpat%s		g-regpat.ads		c72dc161 NE OL PR
W gnat%s		gnat.ads		gnat.ali
W system%s		system.ads		system.ali
W system.regpat%s	s-regpat.adb		s-regpat.ali

D ada.ads		20070406091342 3ffc8e18
D a-unccon.ads		20070406091342 f9eb8f06
D gnat.ads		20050905075125 fd2ad2f1
D g-regpat.ads		20080820135520 b85d88ef
D system.ads		20120503154647 23e1f70b
D s-exctab.ads		20090417131547 66e51330
D s-regpat.ads		20080914062112 825a9b7f
D s-stalib.ads		20101021102512 c4241c00
X 3 gnat.ads
36K9*GNAT 39e9 4|74r9
X 4 g-regpat.ads
74K14*Regpat=74:36
X 5 system.ads
37K9*System 4|72r6 74r29 5|153e11
X 7 s-regpat.ads
47K16*Regpat 4|72w13 74r36 7|646e18

