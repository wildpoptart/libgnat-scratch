V "GNAT Lib v4.6"
A -gnatwa
A -O2
A -O2
A -Wextra
A -Wall
A -fexceptions
A -fPIC
A -g
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=x86-64
P ZX
R nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn

U gnat.secondary_stack_info%s  g-sestin.ads	84ec1919 NE OL PK
W gnat%s		gnat.ads		gnat.ali
W system%s		system.ads		system.ali
W system.secondary_stack%s  s-secsta.adb	s-secsta.ali

D ada.ads		20070406091342 3ffc8e18
D a-unccon.ads		20070406091342 f9eb8f06
D gnat.ads		20050905075125 fd2ad2f1
D g-sestin.ads		20050701012917 976591de
D system.ads		20120503154647 23e1f70b
D s-secsta.ads		20090707124243 eea35a36
D s-stoele.ads		20090417130712 facd7d98
D s-stoele.adb		20100617152355 afc5dc80
X 3 gnat.ads
36K9*GNAT 39e9 4|39r9 50r5
X 4 g-sestin.ads
39K14*Secondary_Stack_Info 3|36k9 4|50l10 50e30
41V13*SS_Get_Max=42:37{long_long_integer}
X 5 system.ads
37K9*System 4|37r6 42r14 5|153e11
X 6 s-secsta.ads
36K16*Secondary_Stack 4|37w13 42r21 6|119e27
88V13*SS_Get_Max{long_long_integer} 4|42r37

