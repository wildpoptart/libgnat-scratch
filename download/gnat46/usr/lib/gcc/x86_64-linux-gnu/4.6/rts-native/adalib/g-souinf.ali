V "GNAT Lib v4.6"
A -gnatwa
A -O2
A -O2
A -Wextra
A -Wall
A -fexceptions
A -fPIC
A -g
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=x86-64
P ZX
R nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn

U gnat.source_info%s	g-souinf.ads		1b4527ff NE OL PU PK
W gnat%s		gnat.ads		gnat.ali

D gnat.ads		20050905075125 fd2ad2f1
D g-souinf.ads		20050905075401 e66ff50e
D system.ads		20120503154647 23e1f70b
X 1 gnat.ads
36K9*GNAT 39e9 2|41r9 78r5
X 2 g-souinf.ads
41K14*Source_Info 1|36k9 2|78l10 78e21
44V13*File{string} 74b30
48V13*Line{positive} 75b30
52V13*Source_Location{string} 76b30
60V13*Enclosing_Entity{string} 77b30

