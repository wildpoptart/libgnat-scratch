V "GNAT Lib v4.6"
A -gnatwa
A -O2
A -O2
A -Wextra
A -Wall
A -fexceptions
A -fPIC
A -g
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=x86-64
P ZX
R nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn

U machine_code%s	machcode.ads		5d92901f NE OL PU
W system%s		system.ads		system.ali
W system.machine_code%s	s-maccod.ads		s-maccod.ali

D machcode.ads		20070406091342 678d4680
D system.ads		20120503154647 23e1f70b
D s-maccod.ads		20090409150019 3a1fd69f
X 1 machcode.ads
18K9*Machine_Code=18:37
X 2 system.ads
37K9*System 1|16r6 18r30 2|153e11
X 3 s-maccod.ads
36K16*Machine_Code 1|16w13 18r37 3|126e24

