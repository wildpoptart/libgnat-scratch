V "GNAT Lib v4.6"
A -gnatwa
A -O2
A -O2
A -Wextra
A -Wall
A -fexceptions
A -fPIC
A -g
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=x86-64
P ZX
R nnnnnnnnnnnnnnnnnnnnnvnnvnnnnnnnnnnnnnnnnnnnvnnnnnnnnnnnnnnnvvnvnnnnnnnnnnnnnnnn

U system.fat_sflt%s	s-fatsfl.ads		537e4e9d EE OL PU PK
W ada%s			ada.ads			ada.ali
W ada.unchecked_conversion%s
W system%s		system.ads		system.ali
W system.fat_gen%s
W system.unsigned_types%s  s-unstyp.ads		s-unstyp.ali

D ada.ads		20070406091342 3ffc8e18
D a-unccon.ads		20070406091342 f9eb8f06
D system.ads		20120503154647 23e1f70b
D s-fatgen.ads		20090409150019 9267ca45
D s-fatgen.adb		20100909085708 9ba81cee
D s-fatsfl.ads		20090409150019 e2f873d3
D s-unstyp.ads		20090409150019 6ae15c76
X 3 system.ads
37K9*System 153e11 6|35r6 37r9 45r36 47r5
X 4 s-fatgen.ads
41k16*Fat_Gen 129e19 6|35w13 45r43
X 6 s-fatsfl.ads
37K16*Fat_SFlt 3|37k9 6|47l12 47e20
