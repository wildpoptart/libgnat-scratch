V "GNAT Lib v4.6"
A -gnatwa
A -O2
A -O2
A -Wextra
A -Wall
A -fexceptions
A -fPIC
A -g
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=x86-64
P ZX
R nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnvnnnnnnnnnnnnnnnnnn

U gnat.htable%b		g-htable.adb		a0ae1a73 NE OL PK
W gnat%s		gnat.ads		gnat.ali

U gnat.htable%s		g-htable.ads		2f73d734 BN EB NE OL PR PK
W gnat%s		gnat.ads		gnat.ali
W system%s		system.ads		system.ali
W system.htable%s	s-htable.adb		s-htable.ali

D gnat.ads		20050905075125 fd2ad2f1
D g-htable.ads		20101011104304 3d86a91a
D g-htable.adb		20091130110856 9d28b369
D system.ads		20120503154647 23e1f70b
D s-htable.ads		20101011104304 efdfacdf
X 1 gnat.ads
36K9*GNAT 39e9 2|50r9 229r5 3|41r14 42r5
X 2 g-htable.ads
50K14*HTable 1|36k9 2|229l10 229e16 3|41b19 42l10 42t16
68k20*Simple_HTable
152k20*Static_HTable
223v21*Hash
