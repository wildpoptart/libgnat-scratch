V "GNAT Lib v4.6"
A -gnatwa
A -O2
A -O2
A -Wextra
A -Wall
A -fexceptions
A -fPIC
A -g
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=x86-64
P ZX
R nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn

U gnat.utf_32%s		g-utf_32.ads		19eaef56 NE OL
W gnat%s		gnat.ads		gnat.ali
W system%s		system.ads		system.ali
W system.utf_32%s	s-utf_32.adb		s-utf_32.ali

D gnat.ads		20050905075125 fd2ad2f1
D g-utf_32.ads		20090409150019 19454d35
D system.ads		20120503154647 23e1f70b
D s-utf_32.ads		20101007091606 fd857092
X 1 gnat.ads
36K9*GNAT 39e9 2|47r9
X 2 g-utf_32.ads
47K14*UTF_32=47:36
X 3 system.ads
37K9*System 2|45r6 47r29 3|153e11
X 4 s-utf_32.ads
46K16*UTF_32 2|45w13 47r36 4|211e18

