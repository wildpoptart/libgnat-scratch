V "GNAT Lib v4.6"
A -gnatwa
A -O2
A -O2
A -Wextra
A -Wall
A -fexceptions
A -fPIC
A -g
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=x86-64
P ZX
R nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn

U gnat.task_stack_usage%s  g-tastus.ads		0e008317 NE OL
W gnat%s		gnat.ads		gnat.ali
W system%s		system.ads		system.ali
W system.stack_usage%s	s-stausa.adb		s-stausa.ali
W system.stack_usage.tasking%s  s-stusta.adb	s-stusta.ali

D ada.ads		20070406091342 3ffc8e18
D a-unccon.ads		20070406091342 f9eb8f06
D gnat.ads		20050905075125 fd2ad2f1
D g-tastus.ads		20090429100544 87a908b7
D interfac.ads		20090409150019 f77d8799
D system.ads		20120503154647 23e1f70b
D s-atacco.ads		20090409150019 1dc856ad
D s-stausa.ads		20101018101807 bba781f7
D s-stusta.ads		20090707124243 74835951
D s-stoele.ads		20090417130712 facd7d98
D s-stoele.adb		20100617152355 afc5dc80
X 3 gnat.ads
36K9*GNAT 39e9 4|38r9
X 4 g-tastus.ads
38K14*Task_Stack_Usage=38:58
X 6 system.ads
37K9*System 4|36r6 38r39 6|153e11
X 8 s-stausa.ads
37K16*Stack_Usage 4|36r13 38r46 8|347e23
X 9 s-stusta.ads
42K28*Tasking 4|36w25 38r58 9|77e31

