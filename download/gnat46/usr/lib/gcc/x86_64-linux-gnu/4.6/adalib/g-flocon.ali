V "GNAT Lib v4.6"
A -gnatwa
A -O2
A -O2
A -Wextra
A -Wall
A -fexceptions
A -fPIC
A -g
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=x86-64
P ZX
R nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn

U gnat.float_control%s	g-flocon.ads		29a8c05a NE OL PK
W gnat%s		gnat.ads		gnat.ali

D gnat.ads		20050905075125 fd2ad2f1
D g-flocon.ads		20051115140645 d48212ab
D system.ads		20120503154647 23e1f70b
X 1 gnat.ads
36K9*GNAT 39e9 2|36r9 61r5
X 2 g-flocon.ads
36K14*Float_Control 1|36k9 2|61l10 61e23
38U14*Reset 59b<c,__gnat_init_float>22

