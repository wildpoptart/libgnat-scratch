W ada.text_io.float_io%s
W system.fat_sflt%s	s-fatsfl.ads		s-fatsfl.ali
W system.soft_links%s	s-soflin.adb		s-soflin.ali

U ada.short_float_text_io%s  a-sfteio.ads	1ccd70ef EB NE OL PK
W ada%s			ada.ads			ada.ali
W ada.text_io%s		a-textio.adb		a-textio.ali
W ada.text_io.float_io%s

