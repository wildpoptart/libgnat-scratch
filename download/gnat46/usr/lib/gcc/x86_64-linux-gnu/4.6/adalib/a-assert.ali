V "GNAT Lib v4.6"
A -gnatwa
A -O2
A -O2
A -Wextra
A -Wall
A -fexceptions
A -fPIC
A -g
A -g
A -gnatp
A -gnatg
A -mtune=generic
A -march=x86-64
P ZX
R nnnnnnnnnnnnnnnnnnnnnvnnnnnnnnnnnnnnnnnnnnnnvnnnnnnnnnnnnnnnnvnnnnnnnnnnnnnnnnnn

U ada.assertions%b	a-assert.adb		70eab0ea NE OL PK
W ada%s			ada.ads			ada.ali
W ada.exceptions%s	a-except.adb		a-except.ali

U ada.assertions%s	a-assert.ads		965d4398 NE OL PU PK
W ada%s			ada.ads			ada.ali
W system%s		system.ads		system.ali
W system.assertions%s	s-assert.adb		s-assert.ali

D ada.ads		20070406091342 3ffc8e18
D a-assert.ads		20101018095300 0a052b2b
D a-assert.adb		20090409150019 7aef9bc1
D a-except.ads		20090727140100 0c711ac9
D a-unccon.ads		20070406091342 f9eb8f06
D system.ads		20120503154647 23e1f70b
D s-assert.ads		20090417131547 a3a4e6ab
D s-exctab.ads		20090417131547 66e51330
D s-parame.ads		20091130110856 9c5d83fa
D s-stalib.ads		20101021102512 c4241c00
D s-traent.ads		20090417130712 5221ee41
X 1 ada.ads
16K9*Ada 19e8 2|24r9 36r5 3|32r14 41r16 48r16 52r5
X 2 a-assert.ads
24K13*Assertions 1|16k9 2|25r17 36l9 36e19 3|32b18 41r20 48r20 52l9 52t19
27X4*Assertion_Error 3|41r31 48r31
32U14*Assert 32>22 3|38b14 43l8 43t14
32b22 Check{boolean} 3|38b22 40r10
34U14*Assert 34>22 34>39 3|45b14 50l8 50t14
34b22 Check{boolean} 3|45b22 47r10
34s39 Message{string} 3|45b39 48r52
